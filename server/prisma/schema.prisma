// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  MEMBER
}

enum SessionStatus {
  VOTING
  CONFIRMED
  BOOKED
  COMPLETED
  CANCELLED
}

enum VoteStatus {
  JOIN
  DECLINE
  MAYBE
}

enum PaymentStatus {
  PENDING
  PAID
  CONFIRMED
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  phone        String?
  bankInfo     String?  @map("bank_info")
  qrCodeImage  String?  @map("qr_code_image") @db.Text
  avatar       String?  @db.Text
  role         Role     @default(MEMBER)
  tier         String?
  isGoalkeeper Boolean  @default(false) @map("is_goalkeeper")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  createdSessions Session[] @relation("SessionCreator")
  paidSessions    Session[] @relation("SessionPayer")
  votes           Vote[]
  payments        Payment[]
  absenceLogs     AbsenceLog[]

  @@map("users")
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_verifications")
}

model Session {
  id         String        @id @default(uuid())
  title      String
  playDate   DateTime      @map("play_date")
  startTime  String        @map("start_time")
  endTime    String        @map("end_time")
  location   String
  minPlayers Int           @map("min_players")
  maxPlayers Int           @map("max_players")
  totalCost  Decimal?      @map("total_cost") @db.Decimal(10, 2)
  status     SessionStatus @default(VOTING)
  teams      Json?         @map("teams")

  voteDeadline DateTime? @map("vote_deadline")
  isVoteLocked Boolean   @default(false) @map("is_vote_locked")
  voteLockedAt DateTime? @map("vote_locked_at")

  // Foreign keys
  createdById String  @map("created_by")
  payerId     String? @map("payer_id")

  // Relations
  createdBy   User          @relation("SessionCreator", fields: [createdById], references: [id])
  payer       User?         @relation("SessionPayer", fields: [payerId], references: [id])
  votes       Vote[]
  payments    Payment[]
  absenceLogs AbsenceLog[]
  guests      GuestPlayer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sessions")
}

model Vote {
  id          String     @id @default(uuid())
  status      VoteStatus @default(JOIN)
  votedAt     DateTime   @default(now()) @map("voted_at")
  isCheckedIn Boolean    @default(false) @map("is_checked_in")
  checkedInAt DateTime?  @map("checked_in_at")
  checkInNote String?    @map("check_in_note")

  // Foreign keys
  sessionId String @map("session_id")
  userId    String @map("user_id")

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  // Mỗi user chỉ vote 1 lần cho mỗi session
  @@unique([sessionId, userId])
  @@map("votes")
}

model AbsenceLog {
  id                 String   @id @default(uuid())
  sessionId          String   @map("session_id")
  userId             String   @map("user_id")
  reason             String?  @db.Text
  reportedAt         DateTime @default(now()) @map("reported_at")
  isLate             Boolean  @default(false) @map("is_late")
  minutesBeforeMatch Int?     @map("minutes_before_match")

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("absence_logs")
}

model GuestPlayer {
  id           String    @id @default(uuid())
  sessionId    String    @map("session_id")
  name         String
  phone        String?
  tier         String?   @default("C")
  isGoalkeeper Boolean   @default(false) @map("is_goalkeeper")
  status       String    @default("RESERVE") // "RESERVE" hoặc "PLAYING"
  isCheckedIn  Boolean   @default(false) @map("is_checked_in")
  checkedInAt  DateTime? @map("checked_in_at")
  note         String?   @db.Text
  addedAt      DateTime  @default(now()) @map("added_at")

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("guest_players")
}

model Payment {
  id          String        @id @default(uuid())
  amount      Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  orderCode     BigInt?       @unique @map("order_code")
  checkoutUrl   String?       @map("checkout_url")
  paymentLinkId String?       @map("payment_link_id")
  paidAt        DateTime?     @map("paid_at")
  confirmedAt   DateTime?     @map("confirmed_at")

  // Foreign keys
  sessionId String @map("session_id")
  userId    String @map("user_id")

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@map("payments")
}
