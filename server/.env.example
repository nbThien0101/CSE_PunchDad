# =================================
# Server Environment Configuration
# =================================

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/cse_punchdad?schema=public"

# JWT
# Generate each key separately: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=5001
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"

# Email Service (Brevo API khuyên dùng cho Cloud/Render hoặc Gmail SMTP)
BREVO_API_KEY="xkeysib-..."
SMTP_EMAIL="csepunchdad@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"

# PayOS Configuration (VietQR Payment Gateway)
PAYOS_CLIENT_ID="your-payos-client-id"
PAYOS_API_KEY="your-payos-api-key"
PAYOS_CHECKSUM_KEY="your-payos-checksum-key"
