# =================================
# Server Environment Configuration
# =================================

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/cse_punchdad?schema=public"

# JWT
# Generate each key separately: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=5001
NODE_ENV=development

# Client URL (for CORS - hỗ trợ nhiều domain cách nhau bởi dấu phẩy, vd web + iOS PWA)
CLIENT_URL="http://localhost:5173"
MOBILE_CLIENT_URL=""

# Email Service (Brevo API khuyên dùng cho Cloud/Render hoặc Gmail SMTP)
BREVO_API_KEY="xkeysib-..."
SMTP_EMAIL="csepunchdad@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"

# PayOS Configuration (VietQR Payment Gateway)
PAYOS_CLIENT_ID="your-payos-client-id"
PAYOS_API_KEY="your-payos-api-key"
PAYOS_CHECKSUM_KEY="your-payos-checksum-key"

# Push Notifications - Web Push (iOS PWA "Add to Home Screen" & Web Browser)
# Generate VAPID keys: npm run vapid:generate (inside server/)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:csepunchdad@gmail.com"

# Push Notifications - Firebase Cloud Messaging (Android APK)
# Dán toàn bộ nội dung JSON (hoặc base64) của Firebase Service Account vào FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Hoặc cấu hình rời từng biến (tùy chọn):
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""

# Push Notifications - Expo Push (tùy chọn nếu Android APK dùng Expo Enhanced Push Security)
EXPO_ACCESS_TOKEN=""
